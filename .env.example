# Copie para .env e preencha. Nunca commite o .env.
# Gere chaves com: openssl rand -hex 32

# desenvolvimento | teste | producao (ausente ou desconhecido = producao)
AMBIENTE=desenvolvimento
PORTA=8080

# Postgres do docker compose (porta 55432 no host)
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=

# Usuário da aplicação (membro de motor_app, sujeito à RLS) e dono das tabelas (só para migrar)
DATABASE_URL=postgres://motor_api:SENHA@127.0.0.1:55432/motor?sslmode=disable
DATABASE_URL_MIGRACAO=postgres://motor_dono:SENHA@127.0.0.1:55432/motor?sslmode=disable

# Obrigatórias: sem elas a API não sobe. 32 bytes em hexadecimal.
CHAVE_HMAC_DOC=
CHAVE_CIFRA_DOC=

# Fonte do cadastro de CNPJ: simulado | brasilapi (Receita via BrasilAPI, sem SLA). Com brasilapi o score do CNPJ
# passa a ser o cadastral (dados públicos); restrições e protestos seguem simulados.
# No código (go run ./cmd/api) o padrão, com a variável vazia, é simulado. O docker compose de demonstração liga
# brasilapi quando ela está vazia ou ausente; para desligar no compose, escreva BUREAU_CNPJ=simulado.
# Valor desconhecido impede a API de subir.
BUREAU_CNPJ=

# Fonte do cadastro de CPF: simulado | serpro-trial | serpro. Padrão simulado (código e compose).
# serpro-trial: ambiente de testes público do Serpro (CPFs fictícios, cota mínima); SERPRO_URL/SERPRO_CHAVE vazias
# usam a URL e a chave públicas do trial. serpro: produção; sem SERPRO_URL e SERPRO_CHAVE a API não sobe.
# O Serpro exige o nascimento: consulta de CPF sem dados.nascimento fica com cadastro "nao_verificado".
BUREAU_CPF=
SERPRO_URL=
SERPRO_CHAVE=

# Retenção LGPD (cmd/retencao): consultas mais velhas que isto perdem o documento. Padrão 1825 (5 anos); inteiro ≥ 1.
RETENCAO_DIAS=

# Cookie sem Secure só com on E ambiente diferente de producao
COOKIE_INSEGURO_DEV=
# Cria tenant e admin de demonstração (só fora de producao)
SEED_DEMO=

# Painel: base da API (vazio = mesma origem, via proxy do Vite)
VITE_API_URL=
