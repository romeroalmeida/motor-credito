    {
      "name": "Painel",
      "description": "entrar → 2fa → telas. O Postman guarda os cookies; o pre-request copia o cookie csrf para X-CSRF.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Cookies de sessão: o Postman guarda o \"sessao\" (httpOnly) e o \"csrf\" sozinho. Toda escrita no painel precisa",
              "// repetir o cookie csrf no cabeçalho X-CSRF (double submit). Lê do cookie jar; se o domínio não estiver liberado",
              "// para scripts (Postman app: Cookies → Domains Allowlist → 127.0.0.1), usa o valor guardado pelos testes.",
              "const usar = (valor) => {",
              "  if (valor) pm.request.headers.upsert({ key: 'X-CSRF', value: valor });",
              "};",
              "try {",
              "  pm.cookies.jar().get(pm.variables.replaceIn('{{base_url}}'), 'csrf', (erro, valor) => {",
              "    usar(!erro && valor ? valor : pm.collectionVariables.get('csrf'));",
              "  });",
              "} catch (e) {",
              "  usar(pm.collectionVariables.get('csrf'));",
              "}"
            ]
          }
        }
      ],
